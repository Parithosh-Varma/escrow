{
  "name": "escrow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "sharp": "^0.35.3",
    "viem": "^2.21.44",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@noble/curves": "^1.5.0",
    "@noble/hashes": "^1.5.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
