# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Leave unset to use embedded PGlite (local dev / tests, zero config).
# Set to your Neon connection string for the real thing:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/escrow?sslmode=require"
DATABASE_URL=

# --- Chain (Base) ---
# off = backend is source of truth (pre-contract-launch dev mode)
# live = on-chain events drive milestone state via the indexer
CHAIN_MODE=off
RPC_URL=https://sepolia.base.org
ESCROW_CONTRACT_ADDRESS=
# Disputes resolve through EscrowCore hooks (MilestoneDisputed/DisputeResolved);
# reserved for a future standalone dispute module.
DISPUTE_CONTRACT_ADDRESS=
INDEXER_START_BLOCK=0
INDEXER_POLL_MS=12000

# --- Keeper bot (live mode) ---
# Sends autoReleaseMilestone / claimRemainder for anything due. Empty = idle.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_MS=30000
KEEPER_GRACE_SECONDS=120

# --- Platform economics ---
PLATFORM_FEE_BPS=200
REVIEW_TIMEOUT_SECONDS=604800
PARTIAL_REMAINDER=refund_to_client

# Dispute juror pool bands (amount in USD cents-equivalent base units of the token)
JUROR_BAND_1_MAX=500000000      # <= $500 -> 3 jurors
JUROR_BAND_2_MAX=5000000000     # <= $5k  -> 5 jurors

# Comma-separated admin/platform-team addresses (phase-1 jurors), lowercase
ADMIN_ADDRESSES=

# AI check providers (empty = NullProvider passes everything; wire keys later)
GPTZERO_API_KEY=
HIVE_API_KEY=

# File storage: memory | disk | s3
STORAGE_DRIVER=disk
STORAGE_DIR=./.data/files

# S3 storage (when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
