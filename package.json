{
  "name": "decentralized-escrow",
  "version": "1.0.0",
  "description": "Trustless multi-party escrow smart contract for EVM chains - ETH & ERC20, arbiter disputes, timeout refunds",
  "main": "index.js",
  "scripts": {
    "test": "npx hardhat test",
    "test:gas": "REPORT_GAS=true npx hardhat test",
    "coverage": "npx hardhat coverage",
    "compile": "npx hardhat compile",
    "node": "npx hardhat node",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network sepolia"
  },
  "keywords": [
    "solidity",
    "escrow",
    "ethereum",
    "hardhat",
    "openzeppelin",
    "erc20",
    "smart-contract",
    "defi"
  ],
  "author": "Parithosh-Varma <demgufever@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^3.0.20",
    "@openzeppelin/contracts": "^5.6.1",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17"
  }
}
